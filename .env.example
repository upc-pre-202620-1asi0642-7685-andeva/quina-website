# Quina Website - Variables de entorno
# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
# Las variables PUBLIC_* terminan en el HTML que ve el visitante: no pongas secretos en ellas.
# Su esquema y valores por defecto están en astro.config.mjs (env.schema).

# URL base de la webapp de Quina (mismo dominio, bajo /app). Los botones
# "Empieza gratis" e "Ingresar" apuntan a <PUBLIC_APP_URL>/register y <PUBLIC_APP_URL>/login.
PUBLIC_APP_URL=https://quina.andeva.tech/app

# Correo de contacto que aparece en el footer, el menú y las preguntas frecuentes.
PUBLIC_CONTACT_EMAIL=hola@quina.andeva.tech

# Correo para ejercer los derechos ARCO (Ley N.° 29733).
PUBLIC_ARCO_EMAIL=datos@quina.andeva.tech

# Datos legales del titular del servicio (Ley N.° 29733 e INDECOPI).
# Completa estos valores reales antes de publicar en producción.
PUBLIC_LEGAL_ENTITY=Andeva (razón social por completar)
PUBLIC_LEGAL_RUC=Por completar
PUBLIC_LEGAL_ADDRESS=Lima, Perú (domicilio fiscal por completar)

# ---------------------------------------------------------------------------
# Integraciones opcionales (si se dejan vacías, el sitio funciona en modo seguro
# sin activar scripts de terceros ni banners innecesarios).
# ---------------------------------------------------------------------------

# Cloudflare Turnstile para el formulario del Libro de Reclamaciones.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Envío automático de la copia del Libro de Reclamaciones por correo (Resend).
# RESEND_API_KEY=
# CLAIMS_FROM_EMAIL=Quina <reclamaciones@quina.andeva.tech>

# Analítica opcional. Cuando tenga valor, el banner de consentimiento de cookies
# aparecerá en la primera visita y solo cargará analítica tras la aceptación.
# PUBLIC_ANALYTICS_ID=
