# Quina Website - Variables de entorno
# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
# Las variables PUBLIC_* terminan en el HTML que ve el visitante: no pongas secretos en ellas.
# Su esquema y valores por defecto están en astro.config.mjs (env.schema).

# URL base de la webapp de Quina (mismo dominio, bajo /app). Los botones
# "Empieza gratis" e "Ingresar" apuntan a <PUBLIC_APP_URL>/register y <PUBLIC_APP_URL>/login.
PUBLIC_APP_URL=https://quina.andeva.tech/app

# Correo de contacto que aparece en el footer, el menú y las preguntas frecuentes.
PUBLIC_CONTACT_EMAIL=hola@quina.andeva.tech

# Correo para ejercer los derechos ARCO (Ley N.° 29733).
PUBLIC_ARCO_EMAIL=datos@quina.andeva.tech

# ---------------------------------------------------------------------------
# Previstas para próximas funciones (aún no se usan en el código).
# Cuando se implementen, agrégalas también a env.schema en astro.config.mjs.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile para el formulario del Libro de Reclamaciones.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Envío de la copia del reclamo por correo al consumidor.
# RESEND_API_KEY=

# Analítica (solo se carga tras el consentimiento de cookies).
# PUBLIC_ANALYTICS_ID=
