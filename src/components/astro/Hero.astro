---
import Button from './Button.astro';
import Picture from './Picture.astro';
import HeroShowcase from './HeroShowcase.astro';
import VideoModal from './VideoModal.astro';
import { site } from '@/data/site';
import { home } from '@/i18n/home';
import { appLinks, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = home[lang].hero;
const how = home[lang].how;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-split">
    <div class="hero-media" data-hero-fade>
      <Picture id="hero-bodeguero-fiado" alt={c.imageAlt} tone="green" loading="eager" />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title" data-split set:html={c.title} />
      <p class="hero-lead" data-hero-fade>
        {c.lead}
      </p>
      <div class="hero-actions" data-hero-fade>
        <Button href={site.appSignupUrl} size="lg">
          <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
            <path
              d="M12 5v14m-7-7h14"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
            />
          </svg>
          {c.primary}
        </Button>
        <Button
          href={c.secondaryHref}
          variant="light"
          size="lg"
          aria-haspopup="dialog"
          data-video-open
        >
          <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
            <path
              d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"
              fill="currentColor"
            />
          </svg>
          {c.secondary}
        </Button>
      </div>
      <p class="hero-login" data-hero-fade>
        {c.hasAccount}{' '}
        <a href={appLinks.login} class="hero-login-link">
          {c.login}
        </a>
      </p>
    </div>
  </div>

  <HeroShowcase lang={lang} />
</section>

<VideoModal
  title={c.videoTitle}
  closeLabel={c.videoClose}
  soon={c.videoSoon}
  posterAlt={how.posterAlt}
/>

<style>
  .hero {
    position: relative;
    padding: 0 0.75rem;
  }

  /*
   * Tarjeta verde oscuro original del hero (con su velo más oscuro arriba) y la foto encajada dentro.
   * Móvil: texto arriba y foto abajo. Desktop: foto a la izquierda, texto a la derecha.
   */
  .hero-split {
    --inset: 0.75rem;
    --card: #1b2a20;
    display: grid;
    gap: var(--inset);
    padding: var(--inset);
    border-radius: 28px;
    background: linear-gradient(180deg, #13201a 0%, var(--card) 60%);
    color: #fff;
  }

  @media (min-width: 1024px) {
    .hero-split {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      min-height: min(100svh - 6rem, 880px);
    }
  }

  /* Radio concéntrico: el de la tarjeta menos el margen interior */
  .hero-media {
    position: relative;
    order: 2;
    aspect-ratio: 4 / 3;
    border-radius: calc(28px - var(--inset));
    overflow: hidden;
  }

  /* La foto llena la celda sin imponer su alto natural a la tarjeta */
  .hero-media :global(.picture) {
    position: absolute;
    inset: 0;
    object-position: 50% 40%;
  }

  @media (min-width: 1024px) {
    .hero-media {
      order: 0;
      aspect-ratio: auto;
    }
  }

  .hero-copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 0.75rem 2.25rem;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero-copy {
      align-items: flex-start;
      padding: 3rem clamp(2rem, 4vw, 5rem);
      text-align: left;
    }
  }

  /* El tamaño sale del ancho de la columna: «Quina cobra por ti.» siempre entra en una línea */
  .hero-title {
    font-size: clamp(2.25rem, 12cqi, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 1.5rem;
    max-width: 30rem;
    text-wrap: pretty;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 1024px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-login {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.8);
  }

  /* Mismo subrayado que crece de los enlaces del footer, en verde Quina */
  .hero-login-link {
    color: var(--color-primary);
    font-weight: 600;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 350ms var(--ease-out-expo);
  }

  .hero-login-link:hover,
  .hero-login-link:focus-visible {
    background-size: 100% 1px;
  }
</style>
