---
/**
 * Imagen con reemplazo automático: si existe public/images/<id>.(webp|jpg|png)
 * la muestra; si no, pinta un placeholder con el id del prompt de
 * docs/image-prompts.md para saber qué imagen va en ese lugar.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  id: string;
  alt: string;
  class?: string;
  tone?: 'light' | 'dark' | 'green' | 'amber';
  loading?: 'eager' | 'lazy';
}

const { id, alt, class: className = '', tone = 'light', loading = 'lazy' } = Astro.props;

const found = ['webp', 'jpg', 'png'].find((ext) =>
  fs.existsSync(path.join(process.cwd(), 'public', 'images', `${id}.${ext}`)),
);
const src = found ? `/images/${id}.${found}` : null;
---

{src ? (
  <img src={src} alt={alt} loading={loading} decoding="async" class:list={['picture', className]} />
) : (
  <div role="img" aria-label={alt} class:list={['picture placeholder', `tone-${tone}`, className]}>
    <span class="placeholder-id">{id}</span>
  </div>
)}

<style>
  .picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    position: relative;
    display: grid;
    place-items: end start;
    padding: 1rem;
    overflow: hidden;
  }

  .tone-light {
    background-color: #dfe5dc;
    color: #4a564e;
  }
  .tone-dark {
    background-color: #1b2a20;
    color: #a9bdaf;
  }
  .tone-green {
    background-color: #b9efc9;
    color: #0a2e17;
  }
  .tone-amber {
    background-color: #ffe2a6;
    color: #6b4200;
  }

  .placeholder-id {
    font-size: 0.8125rem;
    font-weight: 600;
  }
</style>
