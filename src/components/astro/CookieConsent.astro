---
import { site } from '@/data/site';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const hasAnalytics = Boolean(site.analyticsId);

const copy = {
  es: {
    bannerLabel: 'Aviso de cookies',
    bannerText:
      'Usamos cookies propias para recordar tus preferencias y analítica opcional solo si la aceptas.',
    bannerAccept: 'Aceptar todo',
    bannerNecessary: 'Solo necesarias',
    bannerManage: 'Configurar',
    title: 'Configuración de cookies',
    intro:
      'Elige qué categorías de cookies permites en quina.andeva.tech. Puedes cambiar esta decisión cuando quieras desde el pie de página.',
    close: 'Cerrar configuración de cookies',
    necessaryTitle: 'Estrictamente necesarias',
    necessaryBadge: 'Siempre activas',
    necessaryDesc:
      'Imprescindibles para guardar tu elección de cookies, proteger formularios contra bots (Cloudflare Turnstile) y mantener tu sesión segura en /app.',
    prefsTitle: 'Preferencias de interfaz',
    prefsDesc:
      'Recuerdan tu modo claro u oscuro (quina-theme) y tu idioma elegido (quina-lang) entre el sitio público y la aplicación.',
    analyticsTitle: 'Analíticas',
    analyticsInactiveBadge: 'Inactivas',
    analyticsInactiveDesc:
      'Actualmente Quina no tiene ninguna herramienta de analítica ni rastreo activa en este sitio.',
    analyticsActiveDesc:
      'Nos ayudan a medir visitas de forma agregada y mejorar el rendimiento del sitio. Permanecen desactivadas hasta que las aceptes.',
    policyLink: 'Leer política de cookies',
    onlyNecessary: 'Solo necesarias',
    save: 'Guardar preferencias',
    savedNotice: 'Preferencias guardadas.',
  },
  en: {
    bannerLabel: 'Cookie notice',
    bannerText:
      'We use first-party cookies to remember your preferences and optional analytics only if you accept.',
    bannerAccept: 'Accept all',
    bannerNecessary: 'Necessary only',
    bannerManage: 'Manage',
    title: 'Cookie settings',
    intro:
      'Choose which cookie categories you allow on quina.andeva.tech. You can change your choice anytime from the footer.',
    close: 'Close cookie settings',
    necessaryTitle: 'Strictly necessary',
    necessaryBadge: 'Always active',
    necessaryDesc:
      'Required to save your cookie choice, protect forms from bots (Cloudflare Turnstile), and keep your session secure in /app.',
    prefsTitle: 'Interface preferences',
    prefsDesc:
      'Remember your light or dark theme (quina-theme) and language choice (quina-lang) across the public site and app.',
    analyticsTitle: 'Analytics',
    analyticsInactiveBadge: 'Inactive',
    analyticsInactiveDesc:
      'Quina currently has no analytics or tracking tools active on this site.',
    analyticsActiveDesc:
      'Help us measure visits in aggregate and improve site performance. Disabled by default until you opt in.',
    policyLink: 'Read cookie policy',
    onlyNecessary: 'Necessary only',
    save: 'Save preferences',
    savedNotice: 'Preferences saved.',
  },
  // Borrador en quechua sureño: requiere revisión de un traductor nativo.
  qu: {
    bannerLabel: 'Cookies willakuy',
    bannerText:
      'Akllasqaykikunata yuyarinapaq cookiekunata llamk’achiyku, analítica nisqataqa qam chaskiptillayki.',
    bannerAccept: 'Llapanta chaskiy',
    bannerNecessary: 'Necesario kaqllata',
    bannerManage: 'Allichay',
    title: 'Cookies nisqata allichay',
    intro:
      'Akllay ima cookiekunatam quina.andeva.tech nisqapi saqinki. Hayk’aqpas tikrayta atinki.',
    close: 'Cookies allichayta wichqay',
    necessaryTitle: 'Ancha necesario kaqkuna',
    necessaryBadge: 'Sapa kutilla kichasqa',
    necessaryDesc:
      'Cookies akllasqaykita waqaychanapaq, botkunamanta hark’anapaq (Cloudflare Turnstile) hinaspa /app nisqapi sesionniykita qhawanapaq.',
    prefsTitle: 'Rikchay akllasqakuna',
    prefsDesc:
      'K’anchaq/tutayaq rikchayta (quina-theme) hinaspa simi akllasqaykita (quina-lang) yuyarin.',
    analyticsTitle: 'Analítica',
    analyticsInactiveBadge: 'Wichqasqa',
    analyticsInactiveDesc:
      'Kunanqa Quina manam ima analítica nitaq qatiq herramientatapas llamk’achinchu.',
    analyticsActiveDesc:
      'Sitio imayna llamk’asqanta qhawanapaq. Mana qam chaskiptiykiqa wichqasqam.',
    policyLink: 'Política de cookies ñawinchay',
    onlyNecessary: 'Necesario kaqllata',
    save: 'Akllasqata waqaychay',
    savedNotice: 'Akllasqayki waqaychasqañam.',
  },
}[lang];
---

<div
  class="cookie-root"
  data-cookie-root
  data-has-analytics={hasAnalytics ? 'true' : 'false'}
  data-saved-notice={copy.savedNotice}
>
  {hasAnalytics && (
    <aside
      class="cookie-banner"
      role="region"
      aria-label={copy.bannerLabel}
      data-cookie-banner
      hidden
    >
      <p class="cookie-banner-text">{copy.bannerText}</p>
      <div class="cookie-banner-actions">
        <button type="button" class="cookie-btn cookie-btn-primary" data-cookie-accept-all>
          {copy.bannerAccept}
        </button>
        <button type="button" class="cookie-btn cookie-btn-ghost" data-cookie-reject-all>
          {copy.bannerNecessary}
        </button>
        <button type="button" class="cookie-link-btn" data-cookie-settings>
          {copy.bannerManage}
        </button>
      </div>
    </aside>
  )}

  <dialog
    class="cookie-dialog"
    aria-labelledby="cookie-dialog-title"
    aria-describedby="cookie-dialog-desc"
    data-cookie-dialog
  >
    <div class="cookie-dialog-inner">
      <header class="cookie-dialog-head">
        <div>
          <h2 id="cookie-dialog-title" class="cookie-dialog-title">
            {copy.title}
          </h2>
          <p id="cookie-dialog-desc" class="cookie-dialog-desc">
            {copy.intro}
          </p>
        </div>
        <button type="button" class="cookie-close" aria-label={copy.close} data-cookie-close>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </header>

      <div class="cookie-groups">
        <div class="cookie-group">
          <div class="cookie-group-head">
            <span class="cookie-group-title">{copy.necessaryTitle}</span>
            <span class="cookie-badge cookie-badge-active">{copy.necessaryBadge}</span>
          </div>
          <p class="cookie-group-desc">{copy.necessaryDesc}</p>
        </div>

        <div class="cookie-group">
          <div class="cookie-group-head">
            <label for="cookie-toggle-prefs" class="cookie-group-title">
              {copy.prefsTitle}
            </label>
            <input
              id="cookie-toggle-prefs"
              type="checkbox"
              role="switch"
              class="cookie-switch"
              checked
              data-cookie-pref-toggle
            />
          </div>
          <p class="cookie-group-desc">{copy.prefsDesc}</p>
        </div>

        <div class="cookie-group">
          <div class="cookie-group-head">
            {hasAnalytics ? (
              <>
                <label for="cookie-toggle-analytics" class="cookie-group-title">
                  {copy.analyticsTitle}
                </label>
                <input
                  id="cookie-toggle-analytics"
                  type="checkbox"
                  role="switch"
                  class="cookie-switch"
                  data-cookie-analytics-toggle
                />
              </>
            ) : (
              <>
                <span class="cookie-group-title">{copy.analyticsTitle}</span>
                <span class="cookie-badge">{copy.analyticsInactiveBadge}</span>
              </>
            )}
          </div>
          <p class="cookie-group-desc">
            {hasAnalytics ? copy.analyticsActiveDesc : copy.analyticsInactiveDesc}
          </p>
        </div>
      </div>

      <footer class="cookie-dialog-foot">
        <a href="/legal/cookies" class="cookie-policy-link">
          {copy.policyLink}
        </a>
        <div class="cookie-dialog-actions">
          <button type="button" class="cookie-btn cookie-btn-ghost" data-cookie-reject-all>
            {copy.onlyNecessary}
          </button>
          <button type="button" class="cookie-btn cookie-btn-primary" data-cookie-save>
            {copy.save}
          </button>
        </div>
      </footer>
      <p class="sr-only" role="status" aria-live="polite" data-cookie-status></p>
    </div>
  </dialog>
</div>

<style>
  .cookie-banner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    width: min(calc(100% - 2rem), 26rem);
    padding: 1.25rem;
    border-radius: 20px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.16);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner-text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .cookie-banner-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .cookie-dialog {
    margin: auto;
    width: min(calc(100% - 1.5rem), 36rem);
    max-height: min(90dvh, 44rem);
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 24px;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 28px 70px rgb(0 0 0 / 0.25);
    overflow: auto;
  }

  .cookie-dialog::backdrop {
    background: rgb(10 46 23 / 0.55);
    backdrop-filter: blur(6px);
  }

  .cookie-dialog-inner {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .cookie-dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .cookie-dialog-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .cookie-dialog-desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .cookie-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 180ms var(--ease-out-expo);
  }

  .cookie-close:hover {
    background: var(--color-surface-hover);
  }

  .cookie-groups {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .cookie-group {
    padding: 1rem 1.125rem;
    border-radius: 16px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .cookie-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cookie-group-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .cookie-group-desc {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .cookie-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  .cookie-badge-active {
    background: var(--color-soft);
    border-color: transparent;
    color: var(--color-soft-ink);
  }

  .cookie-switch {
    appearance: none;
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 1.625rem;
    border-radius: 9999px;
    background: var(--color-line);
    cursor: pointer;
    transition: background-color 200ms var(--ease-out-expo);
  }

  .cookie-switch::before {
    content: '';
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    transition: translate 200ms var(--ease-out-expo);
  }

  .cookie-switch:checked {
    background: var(--color-primary);
  }

  .cookie-switch:checked::before {
    translate: 1.125rem 0;
  }

  .cookie-dialog-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .cookie-policy-link,
  .cookie-link-btn {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-link-active);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .cookie-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cookie-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    padding-inline: 1.125rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out-expo),
      color 200ms var(--ease-out-expo);
  }

  .cookie-btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .cookie-btn-primary:hover {
    background: #24c65a;
  }

  .cookie-btn-ghost {
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .cookie-btn-ghost:hover {
    background: var(--color-surface-hover);
  }
</style>
