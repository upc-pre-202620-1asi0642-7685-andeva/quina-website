---
import StreetMoneyCalculator from '@/components/react/StreetMoneyCalculator';
import { home } from '@/i18n/home';
import type { Lang } from '@/i18n/ui';

interface Props {
  heading?: boolean;
  lang?: Lang;
}

const { heading = true, lang = 'es' } = Astro.props;
const c = home[lang].calc;
---

<section class="calc-section" aria-label={c.title}>
  <div class="wrap">
    {heading && (
      <div class="calc-head" data-reveal-group>
        <h2 class="calc-title" data-split>
          {c.title}
        </h2>
        <p class="calc-lead" data-reveal>
          {c.lead}
        </p>
      </div>
    )}
    <div data-reveal-group>
      <div data-reveal>
        <StreetMoneyCalculator client:visible lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .calc-section {
    padding-block: clamp(6rem, 4rem + 6vw, 10rem);
    background: var(--color-soft);
  }

  .wrap {
    width: min(100% - 2.5rem, 84rem);
    margin-inline: auto;
  }

  .calc-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .calc-title {
    max-width: 16ch;
    font-size: var(--text-headline);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--color-soft-ink);
  }

  .calc-lead {
    font-size: 1.125rem;
    color: var(--color-soft-ink-2);
  }

  /* Estilos de la isla React (sin scope de Astro) */
  :global(.calc) {
    display: grid;
    gap: 1.5rem;
    color: var(--color-soft-ink);
  }

  @media (min-width: 900px) {
    :global(.calc) {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  :global(.calc-inputs) {
    display: grid;
    gap: 2.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: 24px;
    background: var(--color-surface);
  }

  :global(.calc-field-head) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.875rem;
    font-size: 1.0625rem;
  }

  :global(.calc-field-head output) {
    flex: none;
    white-space: nowrap;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  :global(.calc input[type='range']) {
    width: 100%;
    height: 2.75rem;
    appearance: none;
    background: transparent;
    cursor: pointer;
    touch-action: pan-y;
  }

  :global(.calc input[type='range']::-webkit-slider-runnable-track) {
    height: 8px;
    border-radius: 8px;
    background: linear-gradient(
      to right,
      var(--color-primary) var(--fill),
      var(--color-line) var(--fill)
    );
  }

  :global(.calc input[type='range']::-moz-range-track) {
    height: 8px;
    border-radius: 8px;
    background: var(--color-line);
  }

  :global(.calc input[type='range']::-moz-range-progress) {
    height: 8px;
    border-radius: 8px;
    background: var(--color-primary);
  }

  :global(.calc input[type='range']::-webkit-slider-thumb) {
    appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -10px;
    border-radius: 50%;
    background: var(--color-primary-dark);
    border: 4px solid #fff;
    box-shadow: 0 2px 6px rgb(10 46 23 / 0.3);
    transition: scale 160ms var(--ease-out-expo);
  }

  :global(.calc input[type='range']::-moz-range-thumb) {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary-dark);
    border: 4px solid #fff;
  }

  :global(.calc input[type='range']:active::-webkit-slider-thumb) {
    scale: 1.15;
  }

  :global(.calc-result) {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: 24px;
    background: var(--color-primary-dark);
    color: #fff;
  }

  :global(.calc-result-label) {
    font-size: 1.0625rem;
    color: rgb(255 255 255 / 0.72);
  }

  :global(.calc-big) {
    margin-top: 0.5rem;
    font-size: clamp(3.5rem, 2rem + 6vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }

  :global(.calc-risk) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  :global(.calc-risk strong) {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  :global(.calc-verdict) {
    margin-top: auto;
    padding-top: 2rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.82);
  }
</style>
