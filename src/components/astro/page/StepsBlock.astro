---
import type { Detail } from '@/data/product';

interface Props {
  title: string;
  steps: Detail[];
}

const { title, steps } = Astro.props;
---

<section class="steps-block">
  <div class="wrap">
    <h2 class="block-title" data-split>
      {title}
    </h2>
    <ol class="steps" data-reveal-group>
      {steps.map((s) => (
        <li class="step" data-reveal>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps-block {
    padding-block: clamp(6rem, 4rem + 6vw, 10rem);
  }

  .wrap {
    width: min(100% - 2.5rem, 84rem);
    margin-inline: auto;
  }

  .block-title {
    max-width: 18ch;
    font-size: var(--text-headline);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .steps {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .step {
    padding-top: 1.5rem;
    border-top: 3px solid var(--color-primary);
  }

  .step-title {
    font-size: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .step-text {
    margin-top: 0.875rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
</style>
