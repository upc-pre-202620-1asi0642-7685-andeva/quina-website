---
/**
 * CTA en tarjeta pintada (estructura de Aceternity "CTA with background noise"):
 * titular, texto y botones a la izquierda; a la derecha la ventana de la webapp
 * inclinada en 3D que se sale por el borde. Dentro de la tarjeta un círculo sigue
 * al mouse, invierte lo que tiene debajo y abraza el botón que tocas
 * (data-cursor-zone en src/scripts/site.ts).
 */
import Button from '../Button.astro';
import AppWindow from '../AppWindow.astro';
import Picture from '../Picture.astro';
import { home } from '@/i18n/home';
import { appLinks, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  text?: string;
  /** Muestra "Ver planes"; se apaga en la propia página de planes. */
  secondary?: boolean;
}

const { lang = 'es', secondary = true, ...props } = Astro.props;
const c = home[lang].cta;
const title = props.title ?? c.title;
const text = props.text ?? c.text;
---

<section class="cta-band">
  <div class="cta-card" data-cursor-zone>
    <div class="cta-bg" aria-hidden="true">
      <Picture id="cta-pintura" alt="" tone="green" />
    </div>

    <div class="cta-copy" data-reveal-group>
      <h2 class="cta-title" data-split>
        {title}
      </h2>
      <p class="cta-text" data-reveal>
        {text}
      </p>
      <div class="cta-actions" data-reveal>
        <Button href={appLinks.signup} size="lg" data-cursor-target>
          {c.primary}
          <svg viewBox="0 0 24 24" class="cta-arrow size-5" aria-hidden="true">
            <path
              d="M5 12h14m-6-6 6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </Button>
        {secondary && (
          <Button href={c.secondaryHref} variant="light" size="lg" data-cursor-target>
            <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
              <path
                d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
              />
              <circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" />
            </svg>
            {c.secondary}
          </Button>
        )}
      </div>
    </div>

    <div class="cta-visual" data-tilt>
      <div class="device-frame">
        <AppWindow />
      </div>
    </div>

    <span class="cta-cursor" data-cursor aria-hidden="true"></span>
  </div>
</section>

<style>
  .cta-band {
    padding: 0 0.75rem clamp(6rem, 4rem + 6vw, 10rem);
  }

  /* Tras la banda de color de las preguntas, aire para que no queden pegadas */
  :global(.faq-section) + .cta-band {
    padding-top: clamp(4rem, 3rem + 3vw, 6rem);
  }

  /* La tarjeta es una "foto": igual en ambos temas, con tinta oscura fija */
  .cta-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    padding: clamp(3.5rem, 2.5rem + 4vw, 6.5rem) clamp(1.5rem, 0.5rem + 4vw, 5.5rem);
    overflow: hidden;
    border-radius: 28px;
    color: var(--color-primary-dark);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Velo claro detrás del texto: la pintura tiene pinceladas oscuras en los bordes */
  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(250 248 240 / 0.82) 0%,
        rgb(250 248 240 / 0.55) 40%,
        transparent 65%
      ),
      linear-gradient(0deg, rgb(250 248 240 / 0.35), transparent 50%);
  }

  /* En una columna el texto ocupa toda la tarjeta: el velo la cubre entera para
     que el contraste no dependa de qué pinceladas caigan bajo el texto */
  @media (max-width: 959px) {
    .cta-bg::after {
      background: linear-gradient(
        180deg,
        rgb(250 248 240 / 0.82) 0%,
        rgb(250 248 240 / 0.64) 65%,
        rgb(250 248 240 / 0.45) 100%
      );
    }
  }

  /* Mientras no exista public/images/cta-pintura.*, un fondo pintado con la paleta de Quina */
  .cta-bg :global(.placeholder) {
    background:
      radial-gradient(60% 50% at 12% 18%, #c9f5d6 0%, transparent 70%),
      radial-gradient(45% 40% at 88% 22%, #ffe2a6 0%, transparent 70%),
      radial-gradient(70% 55% at 80% 85%, #7fe3a0 0%, transparent 70%),
      radial-gradient(60% 50% at 15% 90%, #a8ecbd 0%, transparent 70%), #e3f9ea;
    color: rgb(10 46 23 / 0.45);
  }

  /* Columna fija al ancho disponible: si no, la rejilla de botones la ensancha */
  .cta-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    align-content: center;
    gap: 1.5rem;
  }

  .cta-title {
    max-width: 12ch;
    font-size: var(--text-headline);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }

  /* La flecha del principal avanza un poco al pasar el mouse */
  .cta-arrow {
    transition: translate 300ms var(--ease-out-expo);
  }

  .cta-actions :global(.btn:hover) .cta-arrow {
    translate: 0.25rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-arrow {
      transition: none;
    }
  }

  .cta-text {
    max-width: 30rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* Columnas iguales: lado a lado si caben y, si no, apilados a todo el ancho.
     auto-fill deja un solo botón (en /planes) en media fila, no estirado */
  .cta-actions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.875rem;
    justify-self: stretch;
    max-width: 32rem;
    margin-top: 0.75rem;
  }

  .cta-actions :global(.btn) {
    width: 100%;
  }

  /* Los botones van sobre el círculo: los abraza sin invertir su color (el verde
     Quina se queda verde). Va en la fila porque la entrada animada le crea su
     propio contexto de apilamiento. */
  .cta-actions {
    position: relative;
    z-index: 2;
  }

  /* Blanco sobre la pintura clara: un filo verde oscuro marca el borde del botón */
  .cta-actions :global(.btn-light) {
    box-shadow: inset 0 0 0 1px rgb(10 46 23 / 0.25);
  }

  /* La ventana se sale por abajo y por la derecha, como en Aceternity. Solo en
     escritorio: en una columna quedaba recortada y lejos del texto, y alargaba la
     tarjeta sin sumar (es decorativa, aria-hidden). */
  .cta-visual {
    display: none;
    perspective: 1400px;
  }

  .cta-visual .device-frame {
    width: 44rem;
    transform-style: preserve-3d;
    will-change: transform;
  }

  @media (min-width: 960px) {
    .cta-card {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 2rem;
      min-height: 38rem;
      padding-bottom: 0;
    }

    .cta-copy {
      padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    }

    .cta-visual {
      display: block;
      align-self: end;
      margin-right: -12rem;
      margin-bottom: -5rem;
    }
  }

  .cta-cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: #fff;
    mix-blend-mode: exclusion;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
  }
</style>
