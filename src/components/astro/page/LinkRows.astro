---
/** Filas grandes de enlaces con línea que se dibuja (estilo menú Azurio). */
interface Props {
  title: string;
  links: { title: string; text?: string; href: string }[];
}

const { title, links } = Astro.props;
---

<section class="link-rows">
  <div class="wrap">
    <h2 class="block-title" data-split>
      {title}
    </h2>
    <ul class="rows">
      {links.map((l) => (
        <li class="row">
          <span class="row-line" data-rule aria-hidden="true" />
          <a href={l.href} class="row-link">
            <span class="row-title">{l.title}</span>
            {l.text && <span class="row-text">{l.text}</span>}
            <svg viewBox="0 0 24 24" class="row-arrow" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" />
            </svg>
          </a>
        </li>
      ))}
      <li class="row">
        <span class="row-line" data-rule aria-hidden="true"></span>
      </li>
    </ul>
  </div>
</section>

<style>
  .link-rows {
    padding-block: clamp(6rem, 4rem + 6vw, 10rem);
  }

  .wrap {
    width: min(100% - 2.5rem, 84rem);
    margin-inline: auto;
  }

  .block-title {
    font-size: var(--text-headline);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .rows {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .row-line {
    display: block;
    height: 1px;
    background: var(--color-line);
    transform-origin: left;
  }

  .row-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 2rem;
    padding-block: 1.75rem;
  }

  @media (min-width: 900px) {
    .row-link {
      grid-template-columns: 1fr 1fr auto;
    }
  }

  .row-title {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    transition: translate 450ms var(--ease-out-expo);
  }

  .row-text {
    grid-row: 2;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
  }

  @media (min-width: 900px) {
    .row-text {
      grid-row: auto;
    }
  }

  .row-arrow {
    grid-row: 1 / span 2;
    grid-column: -2;
    width: 2rem;
    height: 2rem;
    color: var(--color-link-active);
    transition: translate 450ms var(--ease-out-expo);
  }

  @media (min-width: 900px) {
    .row-arrow {
      grid-row: auto;
    }
  }

  .row-link:hover .row-title {
    translate: 0.75rem 0;
  }

  .row-link:hover .row-arrow {
    translate: 0.5rem 0;
  }
</style>
