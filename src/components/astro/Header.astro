---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Picture from './Picture.astro';
import {
  appLinks,
  isCurrent,
  languages,
  navigation,
  ui,
  langCode,
  langHome,
  type Lang,
} from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const nav = navigation[lang];
const path = Astro.url.pathname;
const homeHref = langHome[lang];
const allLangs = Object.keys(languages) as Lang[];
---

<header class="site-header" data-header>
  <div class="bar">
    <a href={homeHref} class="brand" aria-label={t.home}>
      <Logo class="brand-logo" />
    </a>

    <nav aria-label={t.mainNav} class="main-nav">
      <ul class="nav-list">
        {nav.map((item, i) =>
          item.children ? (
            <li class="nav-item" data-dropdown>
              <button
                type="button"
                class:list={[
                  'nav-trigger',
                  { 'is-current': item.children.some((c) => isCurrent(path, c.href)) },
                ]}
                aria-expanded="false"
                aria-controls={`dd-${i}`}
                data-dropdown-trigger
              >
                {item.label}
                <svg viewBox="0 0 10 6" class="caret" aria-hidden="true">
                  <path d="M0 0h10L5 6z" fill="currentColor" />
                </svg>
              </button>
              <div id={`dd-${i}`} class="dd-panel" data-dropdown-panel>
                <ul>
                  {item.children.map((c, j) => (
                    <li style={`--i:${j}`}>
                      <a
                        href={c.href}
                        class="dd-link"
                        aria-current={isCurrent(path, c.href) ? 'page' : undefined}
                      >
                        <span class="dd-title">{c.label}</span>
                        {c.desc && <span class="dd-desc">{c.desc}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={['nav-trigger', { 'is-current': isCurrent(path, item.href!) }]}
                aria-current={isCurrent(path, item.href!) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="actions">
      <div class="lang" data-dropdown data-dropdown-click>
        <button
          type="button"
          class="icon-btn lang-btn"
          aria-expanded="false"
          aria-controls="dd-lang"
          aria-label={`${t.language}: ${languages[lang]}`}
          data-dropdown-trigger
        >
          <svg viewBox="0 0 24 24" class="lang-icon" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></circle>
            <path
              d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></path>
          </svg>
          <span class="lang-code">{langCode[lang]}</span>
        </button>
        <div id="dd-lang" class="dd-panel dd-center dd-small" data-dropdown-panel>
          <ul>
            {allLangs.map((l, i) => (
              <li style={`--i:${i}`}>
                {l === lang ? (
                  <span class="dd-link" aria-current="true" lang={l}>
                    <span class="dd-title">{languages[l]}</span>
                  </span>
                ) : (
                  <a href={langHome[l]} class="dd-link" hreflang={l} lang={l} data-set-lang={l}>
                    <span class="dd-title">{languages[l]}</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <button
        type="button"
        class="icon-btn theme-btn"
        data-theme-toggle
        data-label-dark={t.themeToDark}
        data-label-light={t.themeToLight}
        aria-label={t.themeToDark}
      >
        <svg viewBox="0 0 24 24" class="theme-icon sun" aria-hidden="true">
          <circle
            cx="12"
            cy="12"
            r="4.2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          ></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg viewBox="0 0 24 24" class="theme-icon moon" aria-hidden="true">
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>

      <a href={appLinks.login} class="login-btn">
        {t.login}
      </a>
      <Button href={appLinks.signup} variant="primary" class="header-cta">
        {t.signup}
      </Button>

      <button
        type="button"
        class="icon-btn menu-toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        <span class="sr-only">{t.openMenu}</span>
        <!-- Líneas en coordenadas enteras para que ambas se vean del mismo grosor -->
        <svg viewBox="0 0 24 24" class="menu-icon" aria-hidden="true">
          <path d="M4 9h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path d="M9 15h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Desenfoque del contenido mientras un menú del header está abierto (open-design) -->
<div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

<div
  id="site-menu"
  class="site-menu"
  role="dialog"
  aria-modal="true"
  aria-label={t.menu}
  data-menu
  inert
>
  <div class="menu-visual" data-menu-visual>
    <Picture id="menu-visual" alt="" tone="dark" />
    <a href={homeHref} class="menu-brand" aria-label={t.home}>
      <Logo class="h-7 w-auto" />
    </a>
  </div>

  <div class="menu-panel" data-menu-panel>
    <div class="menu-top">
      <p class="menu-tagline" data-menu-fade set:html={t.menuTagline} />
      <button type="button" class="menu-close" data-menu-close>
        <span class="sr-only">{t.closeMenu}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-8">
          <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>

    <nav aria-label={t.menu} class="menu-nav">
      <ul>
        {nav.map((item, i) => (
          <li class="menu-item">
            <span class="menu-line" data-menu-line />
            {item.children ? (
              <>
                <button
                  type="button"
                  class="menu-link"
                  aria-expanded="false"
                  aria-controls={`menu-sub-${i}`}
                  data-menu-link
                  data-menu-group
                >
                  <span class="menu-index">/ {String(i + 1).padStart(2, '0')}</span>
                  <span class="menu-label">{item.label}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="menu-arrow menu-plus">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" />
                  </svg>
                </button>
                <div id={`menu-sub-${i}`} class="menu-sub">
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class="menu-sublink" data-menu-close-link>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class="menu-link" data-menu-link data-menu-close-link>
                <span class="menu-index">/ {String(i + 1).padStart(2, '0')}</span>
                <span class="menu-label">{item.label}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" class="menu-arrow">
                  <path
                    d="M5 12h14m-6-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                  />
                </svg>
              </a>
            )}
          </li>
        ))}
        <li class="menu-item">
          <span class="menu-line" data-menu-line></span>
        </li>
      </ul>
    </nav>

    <div class="menu-bottom" data-menu-fade>
      <div class="menu-actions">
        <a href={appLinks.signup} class="menu-cta">
          {t.signup}
        </a>
        <a href={appLinks.login} class="menu-login">
          {t.login}
        </a>
      </div>
      <div class="menu-prefs">
        <div class="seg" role="group" aria-label={t.language}>
          {allLangs.map((l) => (
            <a
              href={l === lang ? undefined : langHome[l]}
              data-set-lang={l}
              class:list={['seg-item', { 'is-active': l === lang }]}
              aria-current={l === lang ? 'true' : undefined}
              aria-label={languages[l]}
              hreflang={l}
            >
              {langCode[l]}
            </a>
          ))}
        </div>
        <a href={`mailto:${site.contactEmail}`} class="menu-mail">
          {site.contactEmail}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    transition:
      box-shadow 300ms ease,
      background-color 300ms ease;
  }

  /* Vidrio al hacer scroll (open-design): el contenido se ve desenfocado detrás.
     El tinte del 84 % mantiene el fondo claro sobre el hero oscuro, para que el
     logo verde y la tinta sigan destacando. */
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--color-paper) 84%, transparent);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-line) 70%, transparent);
  }

  /* Con un menú abierto, el desenfoque de la página ya cubre el fondo: el header vuelve a ser sólido */
  :global(html[data-nav-open]) .site-header {
    background: var(--color-paper);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.5rem;
    padding-inline: clamp(1rem, 0.5rem + 1.6vw, 2rem);
  }

  .brand {
    display: inline-flex;
    flex: none;
    color: var(--color-primary);
  }

  .brand :global(.brand-logo) {
    height: 1.75rem;
    width: auto;
  }

  /* Navegación principal */
  .main-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: color 200ms var(--ease-out-expo);
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded='true'],
  .nav-trigger.is-current {
    color: var(--color-link-active);
  }

  .caret {
    width: 0.5rem;
    height: 0.3rem;
    opacity: 0.55;
    transition: rotate 300ms var(--ease-out-expo);
  }

  .nav-trigger[aria-expanded='true'] .caret {
    rotate: 180deg;
  }

  /* Panel desplegable */
  .dd-panel {
    position: absolute;
    top: calc(100% + 1.6rem);
    left: -0.25rem;
    min-width: 17rem;
    padding: 0.5rem;
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-line),
      0 16px 40px -12px rgb(10 46 23 / 0.22);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    scale: 0.97;
    transform-origin: top left;
    transition:
      opacity 180ms ease,
      translate 260ms var(--ease-out-expo),
      scale 260ms var(--ease-out-expo),
      visibility 0s linear 260ms;
  }

  /* Puente invisible: el cursor no pierde el hover al cruzar el espacio hasta el panel */
  .dd-panel::before {
    content: '';
    position: absolute;
    inset: -1.75rem 0 100%;
  }

  .dd-center {
    left: 50%;
    transform: translateX(-50%);
    transform-origin: top center;
  }

  .dd-center .dd-link {
    align-items: center;
    text-align: center;
  }

  .dd-small {
    min-width: 10rem;
  }

  [data-dropdown][data-open] > .dd-panel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    scale: 1;
    transition-delay: 0s;
  }

  .dd-panel li {
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity 220ms ease,
      translate 320ms var(--ease-out-expo);
  }

  [data-dropdown][data-open] .dd-panel li {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i) * 30ms + 40ms);
  }

  .dd-link {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    transition: background-color 160ms ease;
  }

  a.dd-link:hover,
  a.dd-link:focus-visible {
    background: var(--color-paper-deep);
  }

  .dd-title {
    font-weight: 600;
    font-size: 0.9875rem;
    color: var(--color-ink);
  }

  .dd-link[aria-current] .dd-title {
    color: var(--color-link-active);
  }

  .dd-desc {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }

  /* Acciones */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  .lang {
    position: relative;
    display: flex;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--color-ink);
    transition: background-color 200ms ease;
  }

  /* Hover translúcido: se ve igual sobre el header sólido y sobre el vidrio */
  .icon-btn:hover,
  .icon-btn[aria-expanded='true'],
  .login-btn:hover {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .lang-btn {
    display: inline-flex;
    gap: 0.35rem;
    width: auto;
    padding-inline: 0.75rem;
  }

  .lang-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .lang-code {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .theme-icon {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    transition:
      rotate 500ms var(--ease-out-expo),
      scale 500ms var(--ease-out-expo),
      opacity 250ms ease;
  }

  .moon {
    opacity: 0;
    rotate: -90deg;
    scale: 0.5;
  }

  :global([data-theme='dark']) .sun {
    opacity: 0;
    rotate: 90deg;
    scale: 0.5;
  }

  :global([data-theme='dark']) .moon {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  .login-btn {
    display: none;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.125rem;
    margin-left: 0.25rem;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: background-color 200ms ease;
  }

  .actions :global(.header-cta) {
    display: none;
  }

  @media (min-width: 640px) {
    .actions :global(.header-cta) {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .main-nav {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .login-btn {
      display: inline-flex;
    }
  }

  .menu-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .menu-icon path {
    transition: d 400ms var(--ease-out-expo);
  }

  .menu-toggle:hover .menu-icon path:last-child {
    d: path('M4 15h16');
  }

  /* Desenfoque del contenido mientras un menú del header está abierto */
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-paper) 35%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 300ms ease,
      visibility 0s linear 300ms;
  }

  :global(html[data-nav-open]) .nav-scrim {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* Menú a pantalla completa */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr;
    visibility: hidden;
  }

  .site-menu[data-open] {
    visibility: visible;
  }

  @media (min-width: 768px) {
    .site-menu {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .menu-visual {
    position: relative;
    display: none;
    overflow: hidden;
    background: #0b120d;
    clip-path: inset(0 0 100% 0);
  }

  @media (min-width: 768px) {
    .menu-visual {
      display: block;
    }
  }

  .menu-brand {
    position: absolute;
    top: 2rem;
    left: 2rem;
    color: var(--color-primary);
  }

  .menu-panel {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.25rem 1.5rem 2rem;
    background: var(--color-primary-dark);
    color: #fff;
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
  }

  @media (min-width: 768px) {
    .menu-panel {
      padding: 2.5rem 3rem;
    }
  }

  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .menu-tagline {
    font-size: 1rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.72);
  }

  .menu-close {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: #fff;
    transition: rotate 400ms var(--ease-out-expo);
  }

  .menu-close:hover {
    rotate: 90deg;
  }

  .menu-nav {
    flex: 1;
  }

  .menu-item {
    position: relative;
    overflow: hidden;
  }

  .menu-line {
    display: block;
    height: 1px;
    background: rgb(255 255 255 / 0.2);
    transform-origin: left;
  }

  .menu-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding-block: 1rem;
    text-align: left;
    color: #fff;
  }

  .menu-index {
    min-width: 2.25rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.55);
    font-variant-numeric: tabular-nums;
  }

  .menu-label {
    flex: 1;
    font-size: clamp(1.875rem, 1.4rem + 2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: translate 400ms var(--ease-out-expo);
  }

  .menu-arrow {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-primary);
    transition:
      translate 400ms var(--ease-out-expo),
      rotate 400ms var(--ease-out-expo);
  }

  .menu-link:hover .menu-label {
    translate: 0.5rem 0;
  }

  a.menu-link:hover .menu-arrow {
    translate: 0.375rem 0;
  }

  .menu-link[aria-expanded='true'] .menu-plus {
    rotate: 45deg;
  }

  .menu-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms var(--ease-out-expo);
  }

  .menu-link[aria-expanded='true'] + .menu-sub {
    grid-template-rows: 1fr;
  }

  .menu-sub > ul {
    overflow: hidden;
    padding-left: 3.5rem;
  }

  .menu-sub li:last-child {
    padding-bottom: 1.25rem;
  }

  .menu-sublink {
    display: block;
    padding-block: 0.5rem;
    font-size: 1.25rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.85);
  }

  .menu-sublink:hover {
    color: var(--color-primary);
  }

  .menu-bottom {
    display: grid;
    gap: 1.5rem;
  }

  .menu-actions,
  .menu-prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .menu-actions {
    justify-content: flex-start;
  }

  .menu-cta {
    display: inline-flex;
    align-items: center;
    height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .menu-login {
    display: inline-flex;
    align-items: center;
    height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
    font-weight: 600;
  }

  .seg {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
  }

  .seg-item {
    display: inline-grid;
    place-items: center;
    min-width: 3rem;
    height: 2.5rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.75);
  }

  .seg-item.is-active {
    background: #fff;
    color: var(--color-primary-dark);
  }

  .menu-mail {
    color: rgb(255 255 255 / 0.72);
  }
