---
import '@/styles/index.css';
import Header from '@/components/astro/Header.astro';
import Footer from '@/components/astro/Footer.astro';
import { langHome, ui, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Imagen para compartir (1200 × 630). Ruta dentro de public/. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  lang = 'es',
  image = '/og/quina-og.png',
  imageAlt = 'Quina: Fía tranquilo. Quina cobra por ti. El fiado de tu barrio, con reglas claras.',
} = Astro.props;
const ogImage = new URL(image, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const htmlLang = { es: 'es-PE', en: 'en', qu: 'qu' }[lang];
const ogLocale = { es: 'es_PE', en: 'en_US', qu: 'qu_PE' }[lang];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8fa" />
    <link rel="canonical" href={canonical} />
    {(Object.keys(langHome) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(langHome[l], Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href="/fonts/albert-sans/AlbertSans-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Quina" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      (function () {
        const d = document.documentElement;
        d.classList.add('js');
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch {
          // Sin almacenamiento disponible: se usa la preferencia del sistema
        }
        if (t !== 'dark' && t !== 'light') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a href="#contenido" class="skip-link">
      {ui[lang].skip}
    </a>
    <Header lang={lang} />
    <main id="contenido" data-main class="site-main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>

<style>
  .site-main {
    position: relative;
    z-index: 1;
    background: var(--color-paper);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--color-primary-dark);
    color: #fff;
    translate: 0 -200%;
  }

  .skip-link:focus {
    translate: 0 0;
  }
</style>
